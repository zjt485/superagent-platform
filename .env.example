# =============================================================================
# Superagent deployment configuration
# Copy to .env, fill secrets, then: docker compose up -d --build
# =============================================================================

NODE_ENV=production
LOG_LEVEL=info
APP_NAME=Superagent
PUBLIC_BASE_URL=https://agent.example.com
DOMAIN=agent.example.com

# --- Persistence -------------------------------------------------------------
# Compose overrides DATABASE_URL/REDIS_URL and sets them to the service names.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
DATABASE_URL=postgres://superagent:change-me-to-a-long-random-value@postgres:5432/superagent
REDIS_URL=redis://redis:6379
QUEUE_DRIVER=redis
MIGRATE_ON_START=true

# Without DATABASE_URL the process uses embedded PGlite (development/demo only).
# PGLITE_DIR=./data/pglite

# --- Auth / internal ---------------------------------------------------------
# openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=168
# openssl rand -hex 32
INTERNAL_TOKEN=replace-with-a-random-service-token
AUTH_DEV_LOGIN=false
# Comma separated identity external ids that become platform admins.
PLATFORM_ADMIN_EXTERNAL_IDS=

# --- Feishu (default IM) -----------------------------------------------------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# From the Feishu app's Event Subscription page.
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# Bot open_id, so only real @bot messages are accepted.
FEISHU_BOT_OPEN_ID=
FEISHU_API_BASE=https://open.feishu.cn

# --- WeCom (optional second adapter) ----------------------------------------
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_BOT_NAME=Superagent
WECOM_API_BASE=https://qyapi.weixin.qq.com

# --- GitHub App --------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Inline PEM (with \n escapes) or a mounted file path.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_MODE=app
# GITHUB_MODE=mock simulates GitHub for demos (no network, fake PR URLs).

# --- Worker / agent runtime --------------------------------------------------
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=500
RUN_LEASE_SECONDS=180
WORKSPACES_DIR=/data/workspaces
KEEP_WORKSPACES=false
AGENT_RUNTIME=command
# Contract: the command receives {workspace} and {promptFile}; see
# docs/DEPLOYMENT.md. It must write .superagent/result.json before exiting 0.
AGENT_COMMAND=sh /opt/superagent/agent-wrapper.sh {workspace} {promptFile}
AGENT_TIMEOUT_MINUTES=60
GIT_AUTHOR_NAME=Superagent
GIT_AUTHOR_EMAIL=superagent@example.invalid

# --- Notifications / HTTP ----------------------------------------------------
OUTBOX_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=8
RATE_LIMIT_WEBHOOK_MAX=120
SERVE_WEB=true
