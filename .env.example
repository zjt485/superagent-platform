# =============================================================================
# Superagent deployment configuration
# Copy to .env, fill secrets, then: docker compose up -d --build
# =============================================================================

NODE_ENV=production
LOG_LEVEL=info
APP_NAME=Superagent
PUBLIC_BASE_URL=https://agent.example.com
DOMAIN=agent.example.com

# --- Persistence -------------------------------------------------------------
# Compose overrides DATABASE_URL/REDIS_URL and sets them to the service names.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
DATABASE_URL=postgres://superagent:change-me-to-a-long-random-value@postgres:5432/superagent
REDIS_URL=redis://redis:6379
QUEUE_DRIVER=redis
MIGRATE_ON_START=true

# Without DATABASE_URL the process uses embedded PGlite (development/demo only).
# PGLITE_DIR=./data/pglite

# --- Auth / internal ---------------------------------------------------------
# openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=168
# openssl rand -hex 32
INTERNAL_TOKEN=replace-with-a-random-service-token
AUTH_DEV_LOGIN=false
# Comma separated identity external ids that become platform admins.
PLATFORM_ADMIN_EXTERNAL_IDS=

# --- Feishu (default IM) -----------------------------------------------------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# From the Feishu app's Event Subscription page.
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# Bot open_id, so only real @bot messages are accepted.
FEISHU_BOT_OPEN_ID=
FEISHU_API_BASE=https://open.feishu.cn

# --- WeCom (optional second adapter) ----------------------------------------
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
# Display name the bot uses in group text; keep it in sync with the WeCom app
# bot name so "@<name>" is recognized.
WECOM_BOT_NAME=Superagent
# WeCom 智能机器人 long connection: required to receive group @ mentions.
# appchat self-built apps can send to groups but cannot receive group messages.
# The bot must be added to the project group once by its owner.
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# Optional private-deployment WS endpoint; default wss://openws.work.weixin.qq.com
WECOM_BOT_WS_URL=
WECOM_API_BASE=https://qyapi.weixin.qq.com

# --- GitHub App --------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Inline PEM (with \n escapes) or a mounted file path.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_MODE=app
# GITHUB_MODE=mock simulates GitHub for demos (no network, fake PR URLs).

# --- Worker / agent runtime --------------------------------------------------
# Development/single-node only: run the worker loop inside the API process so a
# local WeCom/Feishu callback can complete the whole Turn → PR pipeline without
# Docker or a second process. Rejected when NODE_ENV=production.
INLINE_WORKER=false
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=500
RUN_LEASE_SECONDS=180
WORKSPACES_DIR=/data/workspaces
KEEP_WORKSPACES=false
# fake | command | openai
AGENT_RUNTIME=command
# command runtime: external agent command must write result.json =
# {"output": <Main decision | Executor report>, "tokens": n, "cost": n} and exit 0.
AGENT_COMMAND=sh /opt/superagent/agent-wrapper.sh {workspace} {promptFile} {inputFile} {resultFile} {turnId} {ticketId}
AGENT_TIMEOUT_MINUTES=60

# Direct OpenAI-compatible runtime (AGENT_RUNTIME=openai). The Executor gets
# read_file / write_file / list_files / run_command tools scoped to its
# workspace. Keep the worker container isolated; never expose .env to it.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_STEPS=20
# Optional cost accounting, USD per 1M tokens; set to your provider's prices.
LLM_INPUT_COST_PER_1M=0
LLM_OUTPUT_COST_PER_1M=0
GIT_AUTHOR_NAME=Superagent
GIT_AUTHOR_EMAIL=superagent@example.invalid

# --- Notifications / HTTP ----------------------------------------------------
OUTBOX_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=8
RATE_LIMIT_WEBHOOK_MAX=120
SERVE_WEB=true
