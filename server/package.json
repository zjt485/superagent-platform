{
  "name": "@superagent/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker-main.ts",
    "start:api": "node dist/index.js",
    "start:worker": "node dist/worker-main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "demo": "tsx src/demo.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.0.4",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.44.0",
    "fast-xml-parser": "^5.0.9",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^3.0.0"
  }
}
